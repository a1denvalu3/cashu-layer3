# cashu-regtest: lnd-3 is the mint's Lightning backend.
TMP_CASH_MINT_BACKEND=lnd
TMP_CASH_MINT_DATA=data/lnd-v3
TMP_CASH_MINT_HOST=127.0.0.1
TMP_CASH_MINT_PORT=3338
# Optional operator API. Generate with: openssl rand -hex 32
# Unset by default; enables authenticated POST /v1/admin/fund for backend liquidity.
# TMP_CASH_ADMIN_TOKEN=your-random-operator-token
TMP_CASH_LND_ENDPOINT=https://localhost:8081
TMP_CASH_LND_CERT=data/lnd-manual/tls.cert
TMP_CASH_LND_MACAROON=data/lnd-manual/admin.macaroon
TMP_CASH_FEE_LIMIT_SAT=10
# Must match the backing node's invoices.holdexpirydelta.
TMP_CASH_LND_HOLD_EXPIRY_DELTA=18
# Requested redeemable lifetime for new LND tokens, in blocks after funding.
# 2016 blocks is about two weeks at Bitcoin's average block interval.
TMP_CASH_LND_TOKEN_LIFETIME_BLOCKS=2016
# Redeem before these margins ahead of the node's hold cancellation deadline.
TMP_CASH_SETTLE_MARGIN_BLOCKS=6
TMP_CASH_SETTLE_MARGIN_SECONDS=120

# Spark alternative: poetry install -E spark, then select backend spark.
# Use a dedicated data directory and keep its SDK storage across restarts.
# TMP_CASH_MINT_BACKEND=spark
# TMP_CASH_MINT_DATA=data/spark-v3
# TMP_CASH_SPARK_NETWORK=mainnet
# TMP_CASH_SPARK_MNEMONIC_FILE=/path/to/mint-spark.mnemonic
# TMP_CASH_SPARK_API_KEY=your-breez-api-key
# TMP_CASH_SPARK_MNEMONIC may be used instead of the mnemonic file.
# Private regtest additionally requires TMP_CASH_SPARK_CONFIG_FILE.
