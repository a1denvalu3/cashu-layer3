# cashu-regtest: lnd-3 is the mint's Lightning backend.
CASHU_MINT_BACKEND=lnd
CASHU_MINT_DATA=data/lnd-v3
CASHU_MINT_HOST=127.0.0.1
CASHU_MINT_PORT=3338
CASHU_LND_ENDPOINT=https://localhost:8081
CASHU_LND_CERT=data/lnd-manual/tls.cert
CASHU_LND_MACAROON=data/lnd-manual/admin.macaroon
CASHU_FEE_LIMIT_SAT=10
# Must match the backing node's invoices.holdexpirydelta.
CASHU_LND_HOLD_EXPIRY_DELTA=18
# Requested redeemable lifetime for new LND tokens, in blocks after funding.
# 2016 blocks is about two weeks at Bitcoin's average block interval.
CASHU_LND_TOKEN_LIFETIME_BLOCKS=2016
# Redeem before these margins ahead of the node's hold cancellation deadline.
CASHU_SETTLE_MARGIN_BLOCKS=6
CASHU_SETTLE_MARGIN_SECONDS=120

# Spark alternative: poetry install -E spark, then select backend spark.
# Use a dedicated data directory and keep its SDK storage across restarts.
# CASHU_MINT_BACKEND=spark
# CASHU_MINT_DATA=data/spark-v3
# CASHU_SPARK_NETWORK=mainnet
# CASHU_SPARK_MNEMONIC_FILE=/path/to/mint-spark.mnemonic
# CASHU_SPARK_API_KEY=your-breez-api-key
# CASHU_SPARK_MNEMONIC may be used instead of the mnemonic file.
# Private regtest additionally requires CASHU_SPARK_CONFIG_FILE.
